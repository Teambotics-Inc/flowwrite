{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "flow-write.teambotics.app"
        }
      ],
      "destination": "https://flowrite.teambotics.app/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "flow-write.teambotics.app"
        }
      ],
      "destination": "https://flowrite.teambotics.app/:path*",
      "permanent": true
    }
  ]
}
